# Gemini API Keys (Get from https://aistudio.google.com/app/apikey)
VITE_GEMINI_API_KEY_TEACHER=your_gemini_api_key_here
VITE_GEMINI_API_KEY_HELPER=your_gemini_api_key_here
VITE_GEMINI_API_KEY_CAPSTONE=your_gemini_api_key_here

# Supabase Credentials (Optional - for saving player progress & database sync)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
